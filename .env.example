# Clipper configuration. Copy to .env and load it however you prefer.
# Everything is optional -- Clipper runs with none of this set.

# --- server ---
CLIPPER_HOST=127.0.0.1
CLIPPER_PORT=8000
CLIPPER_DATA=./data
CLIPPER_MAX_WORKERS=2

# --- binaries (only if not on PATH) ---
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN=C:\ffmpeg\bin\ffprobe.exe

# --- analysis ---
CLIPPER_FRAME_HZ=4
CLIPPER_ANALYSIS_SR=16000

# --- transcription (local, free) ---
# tiny | base | small | medium | large-v3
CLIPPER_WHISPER_MODEL=small
CLIPPER_WHISPER_DEVICE=auto      # auto | cpu | cuda
CLIPPER_WHISPER_COMPUTE=int8
# Silence the HuggingFace symlink warning on Windows (harmless either way):
# HF_HUB_DISABLE_SYMLINKS_WARNING=1
# NOTE: faster-whisper needs "av<19". PyAV 19 removed av.open(metadata_errors=),
# which makes transcription fail silently. See requirements.txt.

# --- clip shape ---
CLIPPER_MIN_CLIP=15
CLIPPER_MAX_CLIP=90
CLIPPER_MAX_CLIPS=10
CLIPPER_PAD_BEFORE=1.2
CLIPPER_PAD_AFTER=1.8

# --- optional AI (OpenAI-compatible) ---
# Leave ALL of this unset and Clipper auto-detects: Ollama if it is running
# locally, otherwise the first free tier with a key present.
#
# Free options, no credit card:
#   CLIPPER_LLM_PROVIDER=ollama     # local, unlimited, private (default)
#   CLIPPER_LLM_PROVIDER=groq       # free tier; set GROQ_API_KEY
#   CLIPPER_LLM_PROVIDER=gemini     # free tier + vision; set GEMINI_API_KEY
#   CLIPPER_LLM_PROVIDER=openrouter # :free models; set OPENROUTER_API_KEY
#
# ollama serve && ollama pull qwen2.5:7b    <- no config needed after this
#
# OpenAI itself is NOT free: new accounts get expiring credits, then per-token.
# CLIPPER_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# CLIPPER_LLM_MODEL=gpt-4o-mini

# Or point at anything OpenAI-compatible (LM Studio, llama.cpp, vLLM, ...):
# CLIPPER_LLM_BASE_URL=http://localhost:11434/v1
# CLIPPER_LLM_MODEL=qwen2.5:7b
# CLIPPER_LLM_API_KEY=
# CLIPPER_LLM_TOP_K=24

# --- vision (lets a prompt match things only SEEN) ---
CLIPPER_USE_VISION=1

# --- behaviour ---
CLIPPER_USE_GRAPHIFY=1
CLIPPER_REFRAME=1
CLIPPER_CAPTIONS=1
CLIPPER_KEEP_SOURCE=1