# Clipper configuration. Copy to .env and load it however you prefer.
# Everything is optional -- Clipper runs with none of this set.

# --- server ---
CLIPPER_HOST=127.0.0.1
CLIPPER_PORT=8000
CLIPPER_DATA=./data
CLIPPER_MAX_WORKERS=2

# --- binaries (only if not on PATH) ---
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN=C:\ffmpeg\bin\ffprobe.exe

# --- analysis ---
CLIPPER_FRAME_HZ=4
CLIPPER_ANALYSIS_SR=16000

# --- transcription (local, free) ---
# tiny | base | small | medium | large-v3
CLIPPER_WHISPER_MODEL=small
CLIPPER_WHISPER_DEVICE=auto      # auto | cpu | cuda
CLIPPER_WHISPER_COMPUTE=int8

# --- clip shape ---
CLIPPER_MIN_CLIP=15
CLIPPER_MAX_CLIP=90
CLIPPER_MAX_CLIPS=10
CLIPPER_PAD_BEFORE=1.2
CLIPPER_PAD_AFTER=1.8

# --- optional LLM judge (OpenAI-compatible) ---
# Ollama:  CLIPPER_LLM_BASE_URL=http://localhost:11434/v1
# Groq:    CLIPPER_LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenAI:  CLIPPER_LLM_BASE_URL=https://api.openai.com/v1
# CLIPPER_LLM_API_KEY=sk-...
# CLIPPER_LLM_MODEL=llama-3.3-70b-versatile
# CLIPPER_LLM_TOP_K=24

# --- behaviour ---
CLIPPER_USE_GRAPHIFY=1
CLIPPER_REFRAME=1
CLIPPER_CAPTIONS=1
CLIPPER_KEEP_SOURCE=1