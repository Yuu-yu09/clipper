{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/(.*)", "dest": "momentclip/web/$1" }
  ],
  "functions": {
    "api/index.py": { "memory": 3008, "maxDuration": 300 }
  }
}